// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  MEMBER
  TRAINER
  MANAGER
}

enum WeekDay {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model User {
  id                       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  username                 String                  @unique
  realname                 String?
  realnameConfirmed        Boolean                 @default(false)
  email                    String                  @unique
  naverId                  String?                 @unique
  kakaoId                  String?                 @unique
  mobile                   String?                 @unique
  avatarImageId            String?                 @unique @db.Uuid
  avatarImage              Image?                  @relation("UserAvatar", fields: [avatarImageId], references: [id], onDelete: SetNull)
  usernameChangeCount      Int                     @default(0) // 변경 횟수
  lastUsernameChangeAt     DateTime? // 마지막 변경 시간
  role                     UserRole                @default(MEMBER)
  trainerProfile           Trainer?
  managerProfile           Manager?
  memberProfile            Member?
  userData                 UserData?
  deletedAt                DateTime?
  rateLimit                RateLimit[]
  chatRoomsAsUserOne       ChatRoom[]              @relation("ChatRoomUserOne")
  chatRoomsAsUserTwo       ChatRoom[]              @relation("ChatRoomUserTwo")
  sentMessages             Message[]
  requestedScheduleChanges ScheduleChangeRequest[] @relation("ScheduleChangeRequestor")
  respondedScheduleChanges ScheduleChangeRequest[] @relation("ScheduleChangeResponder")

  // 업로드한 모든 미디어 (다대일 관계)
  uploadedVideo Video[]
  uploadedImage Image[]

  // 미디어 사용량
  mediaUsage MediaUsage[]

  // 구독 정보
  isPremiumUser      Boolean       @default(false)
  subscriptionExpiry DateTime?
  messageRead        MessageRead[]

  // 에러 로그 관계
  systemErrors SystemError[]
}

model UserData {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction)
  userId    String   @unique @db.Uuid
}

enum MemberLevel {
  BRONZE
  SILVER
  GOLD
  INACTIVE
}

model Member {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id])
  userId            String             @unique @db.Uuid
  pt                Pt[]
  membership        Membership[]
  fitnessCenter     FitnessCenter?     @relation(fields: [fitnessCenterId], references: [id])
  fitnessCenterId   String?            @db.Uuid
  active            Boolean            @default(true)
  ptSurveyResponses PtSurveyResponse[]
  memberLevel       MemberLevel        @default(BRONZE)
}

model WorkingHour {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trainer   Trainer[]
  dayOfWeek WeekDay
  openTime  Int
  closeTime Int

  // 이 WorkingHour를 기본값으로 사용하는 FitnessCenter들
  isDefaultFor FitnessCenter[]

  @@unique([dayOfWeek, openTime, closeTime])
}

model TrainerLevel {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String                  @unique
  displayTitle String                  @unique
  trainers     Trainer[]
  ptProducts   PtProductTrainerLevel[] // 중간 테이블
}

model PtProductTrainerLevel {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  ptProductId String @db.Uuid
  ptProduct   PtProduct @relation(fields: [ptProductId], references: [id], onDelete: Cascade)

  trainerLevelId String @db.Uuid
  trainerLevel   TrainerLevel @relation(fields: [trainerLevelId], references: [id], onDelete: Cascade)

  // 추가 필드 (선택사항)
  incentiveRate Float? @default(0) // 인센티브 비율

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ptProductId, trainerLevelId])
  @@index([ptProductId])
  @@index([trainerLevelId])
}

model Trainer {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id])
  userId            String             @unique @db.Uuid
  introduce         String             @default("안녕하세요")
  level             TrainerLevel?      @relation(fields: [levelId], references: [id])
  levelId           String?            @db.Uuid
  group             Group?             @relation(fields: [groupId], references: [id])
  groupId           String?            @db.Uuid
  pt                Pt[]
  fitnessCenter     FitnessCenter?     @relation(fields: [fitnessCenterId], references: [id])
  fitnessCenterId   String?            @db.Uuid
  trainerOff        TrainerOff[]
  workingHours      WorkingHour[]
  working           Boolean            @default(true)
  auditLogs         LessonAuditLog[] // 감사 로그 관계
  ptSurveyResponses PtSurveyResponse[]
}

model Manager {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id])
  userId         String          @unique @db.Uuid
  group          Group[]
  fitnessCenter  FitnessCenter[]
  trainerOff     TrainerOff[]
  checkedLessons Lesson[]        @relation("checkedManager")
}

model Group {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  manager   Manager   @relation(fields: [managerId], references: [id])
  managerId String    @db.Uuid
  trainers  Trainer[]
}

model ConfigurationValue {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  category  String
  title     String
  text      String
  option    String
  etc       String
}

model PtProduct {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  title             String
  price             Int
  expiration_period Int // 일(day)개념. 첫 수업일을 포함하여 수업이 가능한 날짜 수
  incentivePercent  Int
  description       String
  totalCount        Int
  time              Int                     @default(60) // minute
  onSale            Boolean                 @default(true)
  trainerLevels     PtProductTrainerLevel[]
  openedAt          DateTime                @default(now())
  closedAt          DateTime                @default(dbgenerated("TIMESTAMP '2199-12-31 23:59:59'"))
  pt                Pt[]
}

enum PtState {
  PENDING
  CONFIRMED
  REJECTED
  FINISHED
  REFUNDED
  ACCEPTING
  PAUSED
  WITHDRAWN
}

// 거절, 일시정지 등에 대한 정보를 포괄로 관리하는 모델
model PtChangeInfo {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime  @default(now())
  pt        Pt        @relation(fields: [ptId], references: [id])
  ptId      String    @unique @db.Uuid
  type      String // "PAUSE, REJECT, REFUND 등등"
  reason    String
  changeAt  DateTime
  endAt     DateTime?
}

model Pt {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  ptProduct      PtProduct     @relation(fields: [ptProductId], references: [id])
  ptProductId    String        @db.Uuid
  member         Member?       @relation(fields: [memberId], references: [id])
  memberId       String?       @db.Uuid
  trainer        Trainer?      @relation(fields: [trainerId], references: [id])
  trainerId      String?       @db.Uuid
  state          PtState       @default(PENDING)
  stateUpdatedAt DateTime?
  description    String        @default("")
  goals          String        @default("") // PT 목표 (쉼표로 구분된 문자열)
  expirationDate DateTime?
  extraDays      Int           @default(0) // 일(date) 단위이다. 최종 종료일을 계산할때 expirationDate에 추가해서 계산된다.
  lessons        Lesson[]
  payment        PtPayment?
  startDate      DateTime
  changeInfo     PtChangeInfo?
  contractImage  Image[]
  pauseCount     Int           @default(0)
  pause          PtPause[]
}

model PtPause {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  pt         Pt        @relation(fields: [ptId], references: [id])
  ptId       String    @db.Uuid
  startDate  DateTime // 일시정지 시작일
  endDate    DateTime // 일시정지 종료일
  reason     String // 사유
  days       Int // 계산된 일수 (캐싱용)
  isActive   Boolean   @default(true) // 활성 상태 (취소하면 false)
  canceledAt DateTime? // 취소 시각

  @@index([ptId, isActive]) // 조회 최적화
}

model PtPayment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // PtPayment가 Pt를 필수로 소유 (1:1 관계)
  pt        Pt       @relation(fields: [ptId], references: [id])
  ptId      String   @unique @db.Uuid

  // 결제 관련 필드들
  amount        Int       @default(0)
  discount      Int       @default(0)
  deduction     Int       @default(0)
  method        String // "CARD", "TRANSFER", "CASH" 등
  state         String    @default("PENDING") // "PENDING", "COMPLETED", "FAILED", "REFUNDED"
  transactionId String? // 외부 결제 시스템 거래 ID
  paidAt        DateTime?
  refundedAt    DateTime?
  refundAmount  Int?

  notes String @default("")
}

model Lesson {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  pt              Pt            @relation(fields: [ptId], references: [id])
  ptId            String        @db.Uuid
  fitnessCenter   FitnessCenter @relation(fields: [fitnessCenterId], references: [id])
  fitnessCenterId String        @db.Uuid

  // 스케줄 정보 (LessonSchedule 통합)
  scheduledAt           DateTime // 수업 시작 시간
  endAt                 DateTime // 수업 종료 시간 (새로 추가)
  records               LessonRecord[]
  memo                  String                  @default("")
  isCanceled            Boolean                 @default(false)
  managerCheckedAt      DateTime?
  manager               Manager?                @relation("checkedManager", fields: [managerId], references: [id])
  managerId             String?                 @db.Uuid
  scheduleChangeRequest ScheduleChangeRequest[] // 현재 미사용
  auditLogs             LessonAuditLog[] // 감사 로그 관계

  // 컨디션 기록 관련 필드
  conditionMemo   String? // 컨디션에 대한 텍스트 메모
  conditionImages Image[] @relation("LessonConditionImages") // 여러 컨디션 이미지들

  // 레슨 미디어 (운동 기록용)
  images Image[]
  videos Video[]

  @@index([scheduledAt])
  @@index([ptId, scheduledAt])
}

model LessonRecord {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt                 DateTime                   @default(now())
  lesson                    Lesson                     @relation(fields: [lessonId], references: [id])
  lessonId                  String                     @db.Uuid
  entry                     Int
  description               String?
  type                      RecordType
  title                     String?
  machineSetRecords         MachineSetRecord[]
  freeSetRecords            FreeSetRecord[]
  stretchingExerciseRecords StretchingExerciseRecord[]
  deletedAt                 DateTime? // 소프트 삭제 시간
  deletedUserId             String?                    @db.Uuid // 삭제한 사용자 ID
}

enum ScheduleChangeState {
  PENDING // 변경 요청 대기
  APPROVED // 승인됨
  REJECTED // 거절됨
  EXPIRED // 만료됨
  CANCELLED // 요청자가 취소
}

model ScheduleChangeRequest {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Lesson과 관계 (핵심!)
  lesson   Lesson @relation(fields: [lessonId], references: [id])
  lessonId String @db.Uuid

  // 요청자 정보 (relation name 추가)
  requestor   User   @relation("ScheduleChangeRequestor", fields: [requestorId], references: [id])
  requestorId String @db.Uuid

  // 요청된 새로운 일정 정보
  requestedStartAt DateTime?

  // 원래의 일정
  originalStratAt DateTime

  // 상태 및 메타데이터
  state  ScheduleChangeState @default(PENDING)
  reason String // 변경 사유

  // 응답 정보 (relation name 추가)
  responder       User?     @relation("ScheduleChangeResponder", fields: [responderId], references: [id])
  responderId     String?   @db.Uuid
  responseMessage String? // 승인/거절 사유
  respondedAt     DateTime?

  // 만료 시간
  expiresAt DateTime

  @@index([lessonId])
  @@index([state])
  @@index([expiresAt])
}

enum RecordType {
  MACHINE
  FREE
  STRETCHING
}

enum AuditAction {
  CREATE_ITEM
  UPDATE_ITEM
  DELETE_ITEM
  CREATE_RECORD
  UPDATE_RECORD
}

model MachineBrand {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @unique
  machines  Machine[]
  createdAt DateTime  @default(now())

  @@index([name])
}

model Machine {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  brandId         String           @db.Uuid
  brand           MachineBrand     @relation(fields: [brandId], references: [id])
  model           String?
  description     String
  spec            String?
  musclesUsed     String?
  machineSetting  MachineSetting[]
  fitnessCenter   FitnessCenter?   @relation(fields: [fitnessCenterId], references: [id])
  fitnessCenterId String?          @db.Uuid
  images          Image[]
  videos          Video[]
  isActive        Boolean          @default(true)
  deactivatedAt   DateTime?

  @@index([brandId])
}

model MachineSetting {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  machine   Machine               @relation(fields: [machineId], references: [id])
  machineId String                @db.Uuid
  title     String
  unit      String
  values    MachineSettingValue[]
}

model MachineSettingValue {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  machineSetting    MachineSetting     @relation(fields: [machineSettingId], references: [id])
  machineSettingId  String             @db.Uuid
  value             String
  machineSetRecords MachineSetRecord[]
}

model MachineSetRecord {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime              @default(now())
  settingValues  MachineSettingValue[]
  reps           Int
  weight         Int? // 중량 (kg 단위, nullable)
  set            Int // 몇번째 세트인지
  lessonRecord   LessonRecord          @relation(fields: [lessonRecordId], references: [id], onDelete: Cascade)
  lessonRecordId String                @db.Uuid
}

// 단순화된 운동기구 모델
model Equipment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title String @unique // "덤벨", "바벨", "케틀벨", "밴드", "머신" 등
  unit  String @default("kg") // "kg", "lbs", "개", "세트" 등

  // 센터별 관리 (선택사항)
  fitnessCenter   FitnessCenter? @relation(fields: [fitnessCenterId], references: [id], onDelete: SetNull)
  fitnessCenterId String?        @db.Uuid

  // 중간 테이블과의 관계
  freeSetEquipments    FreeSetEquipment[]
  stretchingEquipments StretchingEquipment[]

  // 미디어 (사진)
  images Image[]

  // 중복 방지
  @@unique([title, unit, fitnessCenterId])
  @@index([fitnessCenterId])
}

model FreeExercise {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime        @default(now())
  title          String          @unique
  description    String?
  images         Image[]
  videos         Video[]
  freeSetRecords FreeSetRecord[]
}

model FreeSetRecord {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime     @default(now())
  freeExercise   FreeExercise @relation(fields: [freeExerciseId], references: [id])
  freeExerciseId String       @db.Uuid

  // 중간 테이블과의 관계 (기존 다대다 관계 대체)
  freeSetEquipments FreeSetEquipment[]

  reps           Int // 횟수
  weight         Int? // 중량 (kg 단위, nullable)
  set            Int // 몇번째 세트인지
  lessonRecord   LessonRecord @relation(fields: [lessonRecordId], references: [id], onDelete: Cascade)
  lessonRecordId String       @db.Uuid
}

model StretchingExercise {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt                DateTime                   @default(now())
  title                    String                     @unique
  description              String
  images                   Image[]
  videos                   Video[]
  stretchingExerciseRecord StretchingExerciseRecord[]
}

model StretchingExerciseRecord {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt            DateTime           @default(now())
  stretchingExercise   StretchingExercise @relation(fields: [stretchingExerciseId], references: [id])
  stretchingExerciseId String             @db.Uuid

  // 중간 테이블과의 관계 (기존 다대다 관계 대체)
  stretchingEquipments StretchingEquipment[]

  description    String?
  lessonRecord   LessonRecord @relation(fields: [lessonRecordId], references: [id], onDelete: Cascade)
  lessonRecordId String       @db.Uuid
}

// ========= FreeSetRecord와 Equipment 연결 테이블 =========
model FreeSetEquipment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  freeSetRecordId String @db.Uuid
  equipmentId     String @db.Uuid

  // 실제 사용한 값 (무게, 개수 등)
  value String? // "15", "20", "빨간색", "중간강도" 등
  notes String? // 추가 메모 (예: "양손 각각", "오른손만")
  order Int     @default(0) // 여러 장비 사용 시 순서

  freeSetRecord FreeSetRecord @relation(fields: [freeSetRecordId], references: [id], onDelete: Cascade)
  equipment     Equipment     @relation(fields: [equipmentId], references: [id])

  @@unique([freeSetRecordId, equipmentId, value]) // 같은 세트에서 같은 장비의 같은 값은 중복 방지
  @@index([freeSetRecordId])
  @@index([equipmentId])
}

// ========= StretchingExerciseRecord와 Equipment 연결 테이블 =========
model StretchingEquipment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  stretchingExerciseRecordId String @db.Uuid
  equipmentId                String @db.Uuid

  // 스트레칭용 장비 정보
  value String? // "빨간색", "중간강도", "1.5m" 등
  notes String? // 추가 메모

  stretchingExerciseRecord StretchingExerciseRecord @relation(fields: [stretchingExerciseRecordId], references: [id], onDelete: Cascade)
  equipment                Equipment                @relation(fields: [equipmentId], references: [id])

  @@unique([stretchingExerciseRecordId, equipmentId])
  @@index([stretchingExerciseRecordId])
  @@index([equipmentId])
}

enum ScheduleState {
  PENDING
  CONFIRMED
  CANCELED
}

model MembershipProduct {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  title       String       @unique
  price       Int
  description String
  totalCount  Int
  onSale      Boolean      @default(true)
  openedAt    DateTime
  closedAt    DateTime
  membership  Membership[]
}

model Membership {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  startedAt           DateTime?
  closedAt            DateTime?
  member              Member            @relation(fields: [memberId], references: [id])
  memberId            String            @db.Uuid
  paid                Boolean           @default(false)
  totalDays           Int
  isActive            Boolean           @default(false)
  membershipProduct   MembershipProduct @relation(fields: [membershipProductId], references: [id])
  membershipProductId String            @db.Uuid
}

model OffDay {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  date            DateTime
  fitnessCenter   FitnessCenter? @relation(fields: [fitnessCenterId], references: [id])
  fitnessCenterId String?        @db.Uuid
}

model TrainerOff {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  startAt        DateTime // 필수 필드로 변경
  endAt          DateTime
  trainer        Trainer   @relation(fields: [trainerId], references: [id])
  trainerId      String    @db.Uuid
  manager        Manager?  @relation(fields: [managerId], references: [id])
  managerId      String?   @db.Uuid
  stateUpdatedAt DateTime?
  state          String    @default("PENDING")
  description    String?
}

model FitnessCenter {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String
  address             String
  addressDetail       String
  postCode            String
  phone               String
  description         String
  openingHours        OpeningHour[]
  defaultWorkingHours WorkingHour[]
  trainers            Trainer[]
  members             Member[]
  managers            Manager[]
  machines            Machine[]
  offDays             OffDay[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  equipments          Equipment[]
  images              Image[]
  lessons             Lesson[]
  inOperation         Boolean       @default(true)
}

model OpeningHour {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fitnessCenter FitnessCenter[]
  dayOfWeek     WeekDay
  openTime      Int
  closeTime     Int
  isClosed      Boolean         @default(false)

  @@unique([dayOfWeek, openTime, closeTime, isClosed]) // isClosed 추가
}

// Session
model RateLimit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  ip        String
  userId    String?  @db.Uuid // 사용자 ID 추가
  count     Int      @default(1)
  resetAt   DateTime
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([ip, userId]) // IP와 userId의 조합으로 유니크 제약
}

// SUPABASE REALTIME DATABASE
model ChatRoom {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  // 1:1 채팅방 참여자 직접 관리
  userOne   User   @relation("ChatRoomUserOne", fields: [userOneId], references: [id])
  userOneId String @db.Uuid
  userTwo   User   @relation("ChatRoomUserTwo", fields: [userTwoId], references: [id])
  userTwoId String @db.Uuid

  messages Message[]

  // 핵심: 두 유저 조합의 유니크 제약
  @@unique([userOneId, userTwoId], name: "unique_chat_participants")
  @@index([userOneId])
  @@index([userTwoId])
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

model Message {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime      @default(now())
  room        ChatRoom      @relation(fields: [roomId], references: [id])
  roomId      String        @db.Uuid
  sender      User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderId    String?       @db.Uuid
  content     String
  messageType MessageType   @default(TEXT)
  isRead      Boolean       @default(false) // 추가된 필드
  messageRead MessageRead[]
}

model MessageRead {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
}

// 기존 모델을 확장하여 통합된 미디어 관리 시스템 구축

model Image {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  // Cloudflare Images ID (custom ID)
  cloudflareId String @unique

  // 이미지 타입
  type ImageType

  // 상태
  status ImageStatus @default(ACTIVE)

  // 대표 이미지 여부
  isPrimary Boolean @default(false)

  // 핵심 관계: 누가 업로드했는지 (필수)
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String @db.Uuid

  // 아바타로 사용되는 경우 (User 모델의 avatarMedia와 연결)
  avatarUser User? @relation("UserAvatar")

  // 다양한 엔티티와의 선택적 관계들
  machine   Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)
  machineId String?  @db.Uuid

  fitnessCenter   FitnessCenter? @relation(fields: [fitnessCenterId], references: [id], onDelete: SetNull)
  fitnessCenterId String?        @db.Uuid

  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  lessonId String? @db.Uuid

  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  equipmentId String?    @db.Uuid

  freeExercise   FreeExercise? @relation(fields: [freeExerciseId], references: [id])
  freeExerciseId String?       @db.Uuid

  stretchingExercise   StretchingExercise? @relation(fields: [stretchingExerciseId], references: [id])
  stretchingExerciseId String?             @db.Uuid

  // 컨디션 이미지로 사용되는 경우 (Lesson과 Many-to-One)
  lessonCondition   Lesson? @relation("LessonConditionImages", fields: [lessonConditionId], references: [id], onDelete: SetNull)
  lessonConditionId String? @db.Uuid

  // PT contract
  pt   Pt?     @relation(fields: [ptId], references: [id])
  ptId String? @db.Uuid

  // PT 설문지 서명 이미지로 사용되는 경우
  surveySignatures PtSurveyResponse[] @relation("SurveySignature")

  // 메타데이터
  metadata Json?

  // 불필요한 user 관계 제거됨!

  @@index([uploadedById])
  @@index([type])
  @@index([status])
  @@index([cloudflareId])
  @@index([machineId, isPrimary])
  @@index([fitnessCenterId, isPrimary])
  @@index([lessonId, isPrimary])
  @@index([equipmentId, isPrimary])
  @@index([freeExerciseId, isPrimary])
  @@index([stretchingExerciseId, isPrimary])
}

enum ImageType {
  PROFILE
  MACHINE
  CENTER
  FREE_EXERCISE
  STRETCHING
  LESSON
  BEFORE_AFTER
  ACHIEVEMENT
  CONDITION // 컨디션 기록용 이미지
  EQUIPMENT
  EVENT
  SIGNATURE // PT 설문지 서명용 이미지
  ETC
  CONTRACT
}

enum ImageStatus {
  ACTIVE
  DELETED
}

model Video {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cloudflare Stream ID                                                 
  streamId String @unique

  // 비디오 타입                                                          
  type VideoType

  // 상태                                                                 
  status VideoStatus @default(PROCESSING)

  // 관계                                                                 
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String @db.Uuid

  // 선택적 관계                                                          
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  lessonId String? @db.Uuid

  machine   Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)
  machineId String?  @db.Uuid

  stretching   StretchingExercise? @relation(fields: [stretchingId], references: [id], onDelete: SetNull)
  stretchingId String?             @db.Uuid

  freeExercise   FreeExercise? @relation(fields: [freeExerciseId], references: [id], onDelete: SetNull)
  freeExerciseId String?       @db.Uuid

  // 메타데이터                                                           
  metadata Json?

  @@index([uploadedById])
  @@index([type])
  @@index([status])
  @@index([streamId])
}

enum VideoType {
  MACHINE
  EXERCISE_DEMO
  LESSON
  FORM_CHECK
  PROGRESS
  INSTRUCTION
  FREE_EXERCISE
  STRETCHING
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  DELETED
}

// 사용자별 미디어 사용량 추적
model MediaUsage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String @db.Uuid

  // 월별 사용량
  month String // "2025-01" 형식

  // 이미지 사용량
  imageCount        Int @default(0)
  imageStorageBytes Int @default(0)

  // 비디오 사용량
  videoCount        Int @default(0)
  videoMinutes      Int @default(0)
  videoStorageBytes Int @default(0)

  // 비용 관련
  estimatedCost Float @default(0)

  @@unique([userId, month])
  @@index([month])
  @@index([userId])
}

// PT 기록 감사 로그
model LessonAuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  // 작업 수행자
  trainerId String  @db.Uuid
  trainer   Trainer @relation(fields: [trainerId], references: [id])

  // 작업 대상
  lessonId       String  @db.Uuid
  lesson         Lesson  @relation(fields: [lessonId], references: [id])
  lessonRecordId String? @db.Uuid

  // 작업 정보
  action        AuditAction
  actionDetails Json? // 변경 전후 데이터

  // 시간 정보
  scheduledTime DateTime? // PT 예정 시간
  isOutOfTime   Boolean   @default(false) // 정상 작업 시간 외 작업 여부

  // 추가 정보
  ipAddress String?
  userAgent String?
  notes     String?

  @@index([trainerId])
  @@index([lessonId])
  @@index([action])
  @@index([isOutOfTime])
  @@index([createdAt])
}

// ===== PT 설문지 시스템 모델들 =====

// PT 설문지
model PtSurvey {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String // 설문지 제목
  description String? // 설문지 설명
  questions   PtSurveyQuestion[]
  responses   PtSurveyResponse[]
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

// 설문 문항
model PtSurveyQuestion {
  id           String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId     String                     @db.Uuid
  survey       PtSurvey                   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  questionText String // 질문 내용
  questionType String // "text", "checkbox", "radio", "agreement"
  options      String[] // 선택지 (JSON 배열)
  isRequired   Boolean                    @default(true)
  order        Int // 질문 순서
  responses    PtSurveyQuestionResponse[]
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@index([surveyId])
  @@index([order])
}

// 설문 응답 (회원별)
model PtSurveyResponse {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId          String                     @db.Uuid
  survey            PtSurvey                   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  memberId          String                     @db.Uuid
  member            Member                     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainerId         String                     @db.Uuid
  trainer           Trainer                    @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  signatureImageId  String?                    @db.Uuid
  signatureImage    Image?                     @relation("SurveySignature", fields: [signatureImageId], references: [id], onDelete: SetNull)
  questionResponses PtSurveyQuestionResponse[]
  completedAt       DateTime                   @default(now())
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([surveyId])
  @@index([memberId])
  @@index([trainerId])
  @@index([completedAt])
}

// 문항별 응답
model PtSurveyQuestionResponse {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responseId String           @db.Uuid
  response   PtSurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String           @db.Uuid
  question   PtSurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String // 응답 내용 (JSON 형태로 저장)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([responseId])
  @@index([questionId])
}

// ========== 에러 로깅 시스템 ==========

enum ErrorLevel {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum ErrorStatus {
  NEW // 새로 발생한 에러
  INVESTIGATING // 조사 중
  IN_PROGRESS // 처리 중
  RESOLVED // 해결됨
  IGNORED // 무시됨 (의도된 에러 등)
}

enum ErrorEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

model SystemError {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 에러 기본 정보
  level       ErrorLevel       @default(ERROR)
  status      ErrorStatus      @default(NEW)
  environment ErrorEnvironment

  // 에러 내용
  message    String // 에러 메시지
  errorCode  String? // 앱에서 정의한 에러 코드 (예: "PT_001", "AUTH_002")
  errorType  String? // 에러 타입 (예: "ValidationError", "DatabaseError")
  stackTrace String? @db.Text // 스택 트레이스 (긴 내용이므로 Text)

  // 컨텍스트 정보
  userId    String? @db.Uuid // 에러 발생 시 로그인한 사용자
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userAgent String? // 브라우저 정보
  ipAddress String? // IP 주소

  // 요청 정보
  method   String? // HTTP 메서드 (GET, POST 등)
  url      String? // 요청 URL
  endpoint String? // API 엔드포인트

  // 추가 메타데이터 (JSON 형태로 유연하게 저장)
  metadata Json? // 추가 디버깅 정보, 요청 body, 파라미터 등
  tags     String[] // 검색/필터링용 태그 (예: ["auth", "payment", "critical"])

  // 처리 관련
  assignedTo String? // 처리 담당자 (개발자 이름이나 ID)
  resolution String?   @db.Text // 해결 방법이나 처리 내용
  resolvedAt DateTime? // 해결 시간

  // 발생 빈도 추적
  occurrenceCount Int      @default(1) // 동일한 에러가 몇 번 발생했는지
  lastOccurredAt  DateTime @default(now()) // 마지막 발생 시간
  fingerprint     String? // 에러를 구분하는 고유 지문 (해시값)

  @@index([level, status])
  @@index([createdAt])
  @@index([userId])
  @@index([environment])
  @@index([fingerprint])
  @@index([tags])
}

// ========== 감사 로그 시스템 ==========
// 통합 감사 로그 - 모든 데이터 변경 이력 관리
model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())

  // 변경 대상
  tableName String // 테이블명 (예: "Pt", "PtPayment", "Lesson" 등)
  recordId  String // 대상 레코드 ID
  action    String // 액션 타입: "CREATE", "UPDATE", "DELETE", "SOFT_DELETE"

  // 변경 데이터
  previousData  Json? // 이전 데이터 (UPDATE, DELETE 시)
  newData       Json? // 새 데이터 (CREATE, UPDATE 시)
  changedFields String[] // 변경된 필드 목록 (UPDATE 시)

  // 변경자 정보
  changedBy     String // User ID
  changedByRole String // 변경자 역할: "MANAGER", "TRAINER", "MEMBER", "SYSTEM"
  changedByName String? // 변경자 이름 (캐시용)

  // 변경 상황
  reason   String? // 변경 사유 (예: "결제 확인", "할인 적용", "오류 수정" 등)
  metadata Json? // 추가 메타데이터 (IP, User-Agent, API endpoint 등)

  // 검색/필터링
  tags String[] // 태그 (예: ["payment", "critical", "manual-update"])

  @@index([tableName, recordId])
  @@index([changedBy])
  @@index([createdAt])
  @@index([tableName, createdAt])
  @@index([tags])
}
